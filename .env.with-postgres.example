# Variant for Postgres also run by the accompanying docker-compose.yml
# Without a Postgres container: .env.example.

# Values below match its service "db".

# Copy to .env next to docker-compose.yml (copied from docker-compose.with-postgres.yml).


# App image for the compose "app" service.
# Paste the digest line we hand you with each release.
PATMAS_APP_IMAGE=docker.io/gunnarpruefer/patmas@sha256:<digest>

# Postgres container (db service)
POSTGRES_DB=patmas
POSTGRES_USER=patmas
POSTGRES_PASSWORD=<password>

# App datasource: host = compose service name "db", database/user/password = POSTGRES_* above.
QUARKUS_DATASOURCE_JDBC_URL=jdbc:postgresql://db:5432/patmas
QUARKUS_DATASOURCE_USERNAME=patmas
QUARKUS_DATASOURCE_PASSWORD=<password>

# App secrets (all required, no prod default; the app fails at startup without them)
PATMAS_BOOTSTRAP_ADMIN_PASSWORD=<admin-password>
# AES-256 key for stored webhook secrets: base64 of 32 bytes, e.g. `openssl rand -base64 32`.
# Keep it stable: changing it makes stored webhook secrets unreadable.
PATMAS_WEBHOOKS_SECRET_KEY=<base64-32-bytes>
